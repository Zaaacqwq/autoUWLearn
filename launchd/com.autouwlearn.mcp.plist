<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.autouwlearn.mcp</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/user/Documents/Code/autoUWLearn &amp;&amp; exec env PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin LEARN_MCP_HOST=127.0.0.1 LEARN_MCP_PORT=8787 LEARN_HEADLESS=false LEARN_BASE_URL=https://learn.uwaterloo.ca LEARN_PROFILE_DIR=/Users/user/Documents/Code/autoUWLearn/.local/learn-browser-profile LEARN_DOWNLOAD_DIR=/Users/user/Documents/Code/autoUWLearn/.local/learn-downloads /opt/homebrew/bin/node dist/httpServer.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/user/Documents/Code/autoUWLearn</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LEARN_MCP_HOST</key>
    <string>127.0.0.1</string>
    <key>LEARN_MCP_PORT</key>
    <string>8787</string>
    <key>LEARN_HEADLESS</key>
    <string>false</string>
    <key>LEARN_BASE_URL</key>
    <string>https://learn.uwaterloo.ca</string>
    <key>LEARN_PROFILE_DIR</key>
    <string>/Users/user/Documents/Code/autoUWLearn/.local/learn-browser-profile</string>
    <key>LEARN_DOWNLOAD_DIR</key>
    <string>/Users/user/Documents/Code/autoUWLearn/.local/learn-downloads</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/autouwlearn-mcp.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/autouwlearn-mcp.err.log</string>
</dict>
</plist>
