<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.autouwlearn.mcp</string>

  <!--
    Run the launcher script rather than node directly. The script sources
    .local/server.env (OAuth password, public base URL) and sets
    LEARN_MCP_ALLOWED_HOSTS, without which requests arriving through the
    Cloudflare tunnel are rejected with 403 by the MCP SDK's DNS-rebinding
    protection.

    Do not add LEARN_* entries to EnvironmentVariables below: the script reads
    every setting as ${VAR:-default}, so anything exported here silently wins
    over both server.env and the script's own defaults. That is how this service
    ended up running headful with no OAuth password configured.

    The script path must stay RELATIVE to WorkingDirectory, and the job must be
    spawned through /bin/zsh. This repo lives under ~/Documents, which macOS
    guards with TCC: a launchd job resolving an absolute path through that
    directory is denied with EPERM ("Operation not permitted"), while a relative
    path from the working directory launchd already opened is allowed.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec bash scripts/start-http.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/user/Documents/Code/autoUWLearn</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/autouwlearn-mcp.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/autouwlearn-mcp.err.log</string>
</dict>
</plist>
